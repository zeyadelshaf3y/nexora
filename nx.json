{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "npm"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test"
      },
      "include": [
        "libs/headless/combobox/**/*",
        "libs/headless/dropdown/**/*",
        "libs/headless/listbox/**/*",
        "libs/headless/listbox-cdk/**/*",
        "libs/headless/mention/**/*",
        "libs/headless/menu/**/*",
        "libs/headless/select/**/*"
      ]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/demo/**/*",
        "libs/headless/combobox/**/*",
        "libs/headless/core/**/*",
        "libs/headless/dropdown/**/*",
        "libs/headless/interactions/**/*",
        "libs/headless/listbox/**/*",
        "libs/headless/listbox-cdk/**/*",
        "libs/headless/mention/**/*",
        "libs/headless/menu/**/*",
        "libs/headless/overlay/**/*",
        "libs/headless/popover/**/*",
        "libs/headless/select/**/*",
        "libs/headless/snackbar/**/*",
        "libs/headless/tooltip/**/*"
      ]
    }
  ],
  "targetDefaults": {
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/angular:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "@nx/angular:ng-packagr-lite": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"]
    }
  },
  "release": {
    "versionPlans": {
      "ignorePatternsForPlanCheck": ["**/package.json"]
    },
    "groups": {
      "nexora-headless": {
        "projects": [
          "core",
          "overlay",
          "interactions",
          "listbox-cdk",
          "listbox",
          "dropdown",
          "popover",
          "menu",
          "tooltip",
          "snackbar",
          "select",
          "combobox",
          "mention",
          "headless"
        ],
        "projectsRelationship": "independent",
        "versionPlans": {
          "ignorePatternsForPlanCheck": ["**/package.json"]
        }
      }
    },
    "version": {
      "preserveMatchingDependencyRanges": false,
      "preVersionCommand": "npx nx run-many -t build",
      "updateDependents": "always"
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": true,
      "workspaceChangelog": false
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): publish",
      "tag": true,
      "push": true
    }
  },
  "generators": {
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-angular",
      "prefix": "nxr"
    },
    "@nx/angular:component": {
      "style": "scss",
      "prefix": "nxr"
    },
    "@nx/angular:application": {
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    }
  },
  "affected": {
    "legacy": true
  },
  "analytics": false
}
