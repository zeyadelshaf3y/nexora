{
  "name": "nexora",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "serve": "nx run demo:serve",
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:all": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "stylelint": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix --allow-empty-input",
    "verify:tree-shake": "nx run demo:build --configuration=production && echo 'Production build done. To verify tooltip-only apps do not pull dialog/drawer: use an app that imports only @nexora-ui/tooltip, build, and grep the bundle for DialogService/DrawerService (see docs/DEVELOPMENT.md).'",
    "release:build:headless": "nx run-many -t build --projects=core,overlay,interactions,listbox-cdk,listbox,dropdown,popover,menu,tooltip,snackbar,select,combobox,mention,headless",
    "release:publish:headless": "for p in core overlay interactions listbox-cdk listbox dropdown popover menu tooltip snackbar select combobox mention headless; do npm publish \"dist/libs/headless/$p\" --access public; done",
    "release:sync-tags": "bash scripts/sync-headless-release-tags.sh",
    "release:sync-npm-dist-tags": "bash scripts/sync-npm-dist-tags.sh",
    "release:verify-versions": "bash scripts/verify-headless-versions.sh",
    "release:nx": "nx release --yes",
    "release:nx:dry-run": "nx release --dry-run --yes",
    "release:headless": "npm run release:build:headless && npm run release:publish:headless"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{html,md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "private": true,
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.5",
    "@analogjs/vitest-angular": "2.7.5",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.6.0",
    "@angular-eslint/template-parser": "22.6.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.6",
    "@nx/devkit": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^22.19.0",
    "@typescript-eslint/utils": "8.72.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.2.7",
    "ng-packagr": "~22.2.0",
    "nx": "24.0.6",
    "postcss": "^8.4.5",
    "postcss-scss": "^4.0.9",
    "postcss-url": "~10.1.3",
    "prettier": "~3.6.2",
    "stylelint": "^17.3.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "verdaccio": "6.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "rxjs": "~7.8.0"
  },
  "nx": {
    "includedScripts": []
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
